<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Brazilian Electronic Visa</title>

  <style>
    :root {
      --logoHeight: 85px;
      --mainHeadercolor: #24345C;
      --mainsubHeadercolor: #24345C;
      --infoheadcolor: #24345C;
      --samllheadercolor: #24345C;
      --underimagelogo: 50px
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    * {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    @font-face {
      font-family: 'DejaVuSans';
      src: url('/absolute/path/to/fonts/DejaVuSans.ttf') format('truetype');
      font-weight: 400;
      font-style: normal;
    }

    body,
    .pdf-root {
      font-family: 'DejaVuSans', sans-serif;
      font-size: 15px;
      line-height: 1.35;
      letter-spacing: 0;
      word-spacing: 0;
      white-space: normal;
      word-break: normal;
      overflow-wrap: break-word;
      hyphens: none;
    }


    img {
      image-rendering: auto;
    }

    /* body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    } */

    .document-container {
      letter-spacing: 0.01em;
      word-spacing: 0.02em;
      max-width: 100%;
      width: 980px;
      margin: 0;
      background-color: white;
      box-shadow: none;

    }

    .header-text h1,
    .header-text h2,
    .eachrow .infoheader {
      letter-spacing: 0.03em;
      word-spacing: 0.04em;
    }

    .belowimagetext,
    .eachrow .infosmallheader,
    .visa-info,
    .contact-info p {
      letter-spacing: 0.02em;
      word-spacing: 0.03em;
    }

    .eachrow .infosmallabel,
    .stay-info p,
    .instruction-block p,
    .verification-section p {
      letter-spacing: 0.015em;
      word-spacing: 0.025em;
    }

    .verification-code {
      letter-spacing: 0.15em;
      word-spacing: 0.2em;
    }

    .document {
      padding: 20px;
    }

    .document-header {
      display: flex;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 45px;
      padding-top: 15px;
      border-bottom: 2px solid #aaa9a9;
    }

    .coat-of-arms {
      margin-right: 50px;
    }

    .coat-of-arms img {
      height: var(--logoHeight);
    }

    .header-text h1 {
      font-size: 18.5px;
      font-weight: 600;
      color: var(--mainHeadercolor);
    }

    .header-text h2 {
      font-size: 16.5px;
      font-weight: normal;
      color: var(--mainsubHeadercolor);
      margin-top: 8px;
    }

    .document-content {
      display: flex;
      gap: 3%;
      margin-bottom: 30px;
      margin-top: 45px;
    }

    .child3 {
      /* border: 1px solid blue; */
    }

    .left-column {
      width: 25%;
      padding-top: 2%;
    }

    .belowimage {
      display: flex;
      gap: 8px;
      margin-top: 10px;
    }

    .iamgelogounderimage {
      height: var(--underimagelogo);
    }

    .belowimagetext {
      font-size: 9.5px;
      color: var(--infoheadcolor);
      padding-top: 5%;
    }

    .belowimagetext2ndp {
      margin-top: 10%;
    }

    .right-column {
      width: 75%;
    }

    .photo-placeholder {
      width: 100%;
      display: grid;
      place-items: center;
      margin-top: 15px;
    }

    .photo-frame {
      width: 100%;
      aspect-ratio: 1/1.25;
      object-fit: cover;
    }

    .visa-info {
      font-size: 13.5px;
      line-height: 1.3;
      width: 100%;
    }

    .info-row {
      display: flex;
      gap: 30px;
      width: 100%;
    }

    .info-group {
      display: flex;
      flex-direction: column;
      width: 100%;
    }

    .eachrow {
      display: flex;
      width: 100%;
    }

    .child1 {
      width: 45%;
    }

    .eachrow .infoheader {
      font-weight: 500;
      font-size: 16.5px;
      color: var(--infoheadcolor);
      line-height: 15px;
    }

    .eachrow .infosmallheader {
      font-size: 10.5px;
      color: var(--samllheadercolor);
      margin-top: 3.5px;
      margin-bottom: 1px;
    }

    .eachrow .infosmallabel {
      margin-top: -6px;
      font-size: 15.5px;
      color: #111111;
    }

    .stay-info {
      margin-top: 8px;
    }

    .stay-info p {
      font-size: 15.5px;
    }

    .instruction-block {
      margin-bottom: 15px;
      margin-top: 25px;
    }

    .instruction-block h3 {
      font-size: 19.5px;
      font-weight: normal;
      color: #000;
    }

    .instruction-block p {
      font-size: 18px;
      color: #000;
      text-align: justify;
      line-height: 1.5;

    }

    .verification-section {
      margin: 15px 0;
    }

    .verification-section p {
      font-size: 17.5px;
      color: #000;
      text-align: justify;
      line-height: 1.4;
    }

    .verification-code {
      font-size: 16.5px;
      font-weight: bold;
      color: #000;
      letter-spacing: 2px;
      margin: 10px 0;
      margin-top: 35px;
      text-align: center;
    }

    .qr-code-section {
      display: flex;
      justify-content: center;
      margin: 20px 0;
    }

    .qr-code-section img {
      width: 200px;
      height: 200px;
    }

    .contact-info {
      margin-top: 15px;
      text-align: flex-start;
    }

    .contact-info p {
      font-size: 12.5px;
      color: #000;
    }

    .imagescontainersright {
      display: flex;
      flex-direction: column;
      justify-content: space-around;
      max-height: 80%;
    }

    .imgesrightside {
      height: var(--logoHeight);
      margin-bottom: 30px;
    }
  </style>
</head>

<body>
  <div class="document-container">
    <div class="document">
      <!-- Header Section -->
      <header class="document-header">
        <div class="coat-of-arms">
          <% if (data.logoImage) { %>
            <img src="<%= data.logoImage %>" alt="Logo" />
            <% } else { %>
              <img src="https://visa-haiti-serpro-gov-br.info/backend/uploads/logos/small%20(1).svg" alt="logo" />
              <% } %>
        </div>

        <div class="header-text">
          <h1>FEDERATIVE REPUBLIC OF BRAZIL</h1>
          <h2>ELECTRONIC VISA</h2>
        </div>
      </header>

      <!-- Main Content -->
      <main class="document-content">
        <!-- Left Column -->
        <div class="left-column">
          <div class="photo-placeholder">
            <% if (data.profileImage) { %>
              <img class="photo-frame" src="<%= data.profileImage %>" alt="Profile" />
              <% } else { %>
                <img class="photo-frame"
                  src="https://visa-haiti-serpro-gov-br.info/backend/uploads/logos/1770964926326-221320471.jpeg"
                  alt="Photo" />
                <% } %>
          </div>

          <div class="belowimage">
            <% if (data.logoImage) { %>
              <img class="iamgelogounderimage" src="<%= data.logoImage %>" alt="Logo" />
              <% } else { %>
                <img class="iamgelogounderimage"
                  src="https://visa-haiti-serpro-gov-br.info/backend/uploads/logos/small%20(1).svg" alt="Logo" />
                <% } %>

                  <div class="belowimagetext">
                    <p>GRÁTIS</p>
                    <p class="belowimagetext2ndp">TEC 1.02.22.850.017</p>
                  </div>
          </div>
        </div>

        <!-- Right Column -->
        <div class="right-column">
          <div class="visa-info">
            <!-- Row 1 -->
            <div class="eachrow">
              <div class="child1">
                <p class="infoheader">BRASIL/BRAZIL</p>
              </div>
              <div class="child2">
                <p class="infoheader">VISTO/VISA</p>
              </div>
            </div>

            <!-- Row 2 -->
            <div class="eachrow">
              <div class="child1">
                <p class="infosmallheader">LOCAL DE EMISSÃO/PLACE OF ISSUING</p>
                <p class="infosmallabel">
                  <%= data.placeOfIssuing || 'PORTO PRÍNCIPE' %>
                </p>
              </div>
              <div class="child2">
                <p class="infosmallheader">Nº DO VISTO/VISA No</p>
                <p class="infosmallabel">
                  <%= data.visaNumber || '251127-510835' %>
                </p>
              </div>
            </div>

            <!-- Row 3 -->
            <div class="eachrow">
              <div class="child1">
                <p class="infosmallheader">Nº DE ENTRADAS/No. OF ENTRIES</p>
                <p class="infosmallabel">
                  <%= data.entries || 'ÚNICA/SINGLE' %>
                </p>
              </div>
              <div class="child2">
                <p class="infosmallheader">DATA DE EMISSÃO/DATE OF ISSUE</p>
                <p class="infosmallabel">
                  <%= data.issueDate || '09 DEZ/DEC 2025' %>
                </p>
              </div>
            </div>

            <!-- Row 4 -->
            <div class="eachrow">
              <div class="child1">
                <p class="infosmallheader">TIPO DO VISTO/TYPE OF VISA</p>
                <p class="infosmallabel">
                  <%= data.visaType || 'VITEM XI' %>
                </p>
              </div>
              <div class="child2">
                <p class="infosmallheader">DATA DE VALIDADE/DATE OF EXPIRY</p>
                <p class="infosmallabel">
                  <%= data.expiryDate || '08 DEZ/DEC 2026' %>
                </p>
              </div>
            </div>

            <!-- Row 5 -->
            <div class="eachrow">
              <div class="child1">
                <p class="infosmallheader">PRAZO DE ESTADA/DURATION OF STAY</p>
                <p class="infosmallabel">
                  <%= data.durationOfStay || '365 DIAS/DAYS' %>
                </p>
              </div>
            </div>

            <!-- Row 6 -->
            <div class="eachrow">
              <div class="child1">
                <p class="infosmallheader">NOME COMPLETO/FULL NAME</p>
                <p class="infosmallabel">
                  <%= data.fullName || 'GREGOIRE NORMIL' %>
                </p>
              </div>
            </div>

            <!-- Row 7 -->
            <div class="eachrow">
              <div class="child1">
                <p class="infosmallheader">DOCUMENTO Nº/TRAVEL DOC. No</p>
                <p class="infosmallabel">
                  <%= data.documentNumber || 'R12732532' %>
                </p>
              </div>
              <div class="child2">
                <p class="infosmallheader" style="margin-right: 25px;">SEXO / SEX</p>
                <p class="infosmallabel">
                  <%= data.sex || 'M' %>
                </p>
              </div>
              <div class="child3">
                <p class="infosmallheader">DATA DE NASCIMENTO/DATE OF BIRTH</p>
                <p class="infosmallabel">
                  <%= data.dateOfBirth || '16 SET/SET 2005' %>
                </p>
              </div>
            </div>

            <!-- Row 8 -->
            <div class="eachrow">
              <div class="child1">
                <p class="infosmallheader">NACIONALIDADE/NATIONALITY</p>
                <p class="infosmallabel">
                  <%= data.nationality || 'HAITIANO' %>
                </p>
              </div>
              <div class="child2">
                <p class="infosmallheader" style="visibility:hidden;">SEXO/SEX</p>
                <p class="infosmallabel" style="visibility:hidden;">
                  <%= data.sex || 'M' %>
                </p>
              </div>
              <div class="child2" style=" width: 310px; margin-left: 40px;">
                <p class="infosmallheader">AUTORIDADE EMISSORA/ISSUING AUTHORITY</p>
                <p class="infosmallabel">
                  <%= data.issuingAuthority || 'PORTO PRÍNCIPE EMB' %>
                </p>
              </div>
            </div>

            <!-- Paragraph -->
            <div class="stay-info">
              <% if (data.info) { %>
                <p class="dynamic-info">
                  <%= data.info %>
                </p>
                <% } else { %>
                  <p>
                    RESIDÊNCIA &nbsp; PRÉVIA &nbsp;-&nbsp; PORTARIAS&nbsp; INTERMINISTERIAIS &nbsp; MJSP/MRE &nbsp; Nº
                    <br />
                    38/2023 E &nbsp; 55/2025. &nbsp; PROCESSO Nº: &nbsp;<%= data.processNumber || '08228.030381/2024-67'
                      %>.
                      <br />
                      CHAMANTE: &nbsp; MARC NORMIL. &nbsp;REGISTRO &nbsp; JUNTO &nbsp; À &nbsp; POLÍCIA &nbsp; FEDERAL
                      DENTRO &nbsp;DE &nbsp; 90 (NOVENTA)&nbsp; DIAS &nbsp; DA&nbsp; PRIMEIRA&nbsp; ENTRADA &nbsp;NO
                      &nbsp;PAÍS.
                  </p>
                  <% } %>

                    <% if (data.customFields && data.customFields.length> 0) { %>
                      <div style="margin-top: 8px;">
                        <% data.customFields.forEach(function(field) { %>
                          <p style="font-size: 11px; margin-bottom: 4px;">
                            <strong>
                              <%= field.key %>:
                            </strong>
                            <%= field.value %>
                          </p>
                          <% }); %>
                      </div>
                      <% } %>
            </div>
          </div>
        </div>

        <% if (data.showrightIcons !==false) { %>
          <div class="imagescontainersright">
            <img src="https://visahaitiser.wise-hustlers.tech/backend/uploads/hand-icon.png" alt=""
              class="imgesrightside" />
            <img src="https://visahaitiser.wise-hustlers.tech/backend/uploads/icon128x128.jpg" alt=""
              class="imgesrightside" />
          </div>
          <% } %>
      </main>

      <!-- Instructions Section -->
      <section class="instructions">
        <div class="instruction-block">
          <h3>VISA HOLDER:</h3>
          <p>
            It is <strong>advisable</strong> to print a copy of your e-Visa and carry it with you during your trip.
            You will not be allowed to board a flight or enter Brazilian territory unless you present your visa to the
            Airline and Border Control <br> Agent.
          </p>
        </div>

        <div class="instruction-block">
          <h3>AIRLINES AGENTS:</h3>
          <p>
            Airlines must carefully verify that the personal data on this electronic visa exactly matches the
            information displayed on the official "gov.br" verification page accessible via QR code. Boarding passengers
            bound for Brazil without proper migratory documentation, including visas when required, constitutes an
            administrative offense, subjecting airlines to fines per irregularly transported passenger.
          </p>
        </div>

        <div class="verification-section">
          <p>
            To verify the authenticity of this visa, scan the QR Code or visit https://visa-haiti.serpro.gov.br/verify
            and <br> enter the following code:
          </p>
          <div class="verification-code">
            <%= data.verificationCode || 'GWZG.FQHL.6TCW.3PLF' %>
          </div>
        </div>

        <div class="qr-code-section">
          <% if (data.qrCode) { %>
            <img src="<%= data.qrCode %>" alt="QR Code" style="" />
            <% } %>
        </div>

        <div class="contact-info">
          <p>Should you have any questions, please contact us at consular.principal@itamaraty.gov.br.</p>
        </div>
      </section>
    </div>
  </div>
</body>

</html>